# GEMINI_API_KEY: clave de Google AI Studio (https://aistudio.google.com/).
# Necesaria para el análisis de geolocalización, la búsqueda en redes
# sociales y la verificación con Google Maps.
GEMINI_API_KEY=

# PORT: puerto en el que escucha el servidor local. Por defecto 3000.
PORT=3000

# HOST: interfaz de red en la que escucha el servidor. Por defecto 127.0.0.1
# (solo tu propio equipo). Cambialo a 0.0.0.0 únicamente si sabes lo que
# haces y entiendes que expones la app (y tu clave de Gemini en el backend)
# a otros equipos de tu red.
HOST=127.0.0.1

# MAX_BODY_SIZE: límite de tamaño para las peticiones JSON (fotos en
# base64). Por defecto 60mb.
MAX_BODY_SIZE=60mb
